# Copy to .env.docker and change every secret before deploying.
# Generate APP_KEY with:  echo "base64:$(openssl rand -base64 32)"
APP_KEY=
APP_URL=http://localhost:8000
APP_PORT=8000

DB_DATABASE=casa_grande
DB_USERNAME=casa
DB_PASSWORD=change-this-password

# Header value clients must send as X-API-Key to /api/*
HOTEL_API_KEY=change-this-hotel-key
# Shared secret between the hotel app and the Payment API
PAYMENT_API_KEY=change-this-payment-key
